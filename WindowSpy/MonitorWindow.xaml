<Window x:Class="WindowSpy.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="雷霆量化 · 行情监控台" Height="780" Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="#0B0D10" Foreground="#E6E9EE"
        FontFamily="Microsoft YaHei UI" FontSize="12">
    <DockPanel>
        <!-- 顶部状态栏 -->
        <Border DockPanel.Dock="Top" Background="#12151B" BorderBrush="#232936" BorderThickness="0,0,0,1" Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="MStatusPill" Background="#2A2F3A" CornerRadius="9" Padding="9,3" VerticalAlignment="Center">
                        <TextBlock x:Name="MStatus" Text="待机" Foreground="#9AA4B2" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="行情监控台" Foreground="#FF8A2A" FontWeight="Bold" FontSize="14"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="轮次" Foreground="#7A8392" FontSize="10"/>
                    <TextBlock x:Name="MRound" Text="0" Foreground="#E6E9EE" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="哈弗币余额" Foreground="#7A8392" FontSize="10"/>
                    <TextBlock x:Name="MWallet" Text="--" Foreground="#58E07D" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="当前持仓" Foreground="#7A8392" FontSize="10"/>
                    <TextBlock x:Name="MHold" Text="空仓" Foreground="#9AA4B2" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="最新价 / 买入价" Foreground="#7A8392" FontSize="10"/>
                    <TextBlock x:Name="MLastPrice" Text="--" Foreground="#E6E9EE" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                    <TextBlock Text="累计已实现盈亏" Foreground="#7A8392" FontSize="10"/>
                    <TextBlock x:Name="MPnl" Text="0" Foreground="#9AA4B2" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="6" VerticalAlignment="Center">
                    <TextBlock Text="成交笔数" Foreground="#7A8392" FontSize="10"/>
                    <TextBlock x:Name="MTrades" Text="0" Foreground="#E6E9EE" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部成交流水 + 资金曲线 -->
        <Border DockPanel.Dock="Bottom" Height="196" Margin="10,0,10,10" Background="#12151B"
                BorderBrush="#232936" BorderThickness="1" CornerRadius="6">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="成交流水" Foreground="#9AA4B2" FontWeight="SemiBold" Margin="2,0,0,6"/>
                    <ListView x:Name="TradeList" Background="Transparent" BorderThickness="0" Foreground="#E6E9EE"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Foreground" Value="#E6E9EE"/>
                                <Setter Property="Padding" Value="2"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="时间" Width="78" DisplayMemberBinding="{Binding TimeText}"/>
                                <GridViewColumn Header="方向" Width="56">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SideText}" Foreground="{Binding SideBrush}" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="子弹" Width="180" DisplayMemberBinding="{Binding Bullet}"/>
                                <GridViewColumn Header="价格" Width="70" DisplayMemberBinding="{Binding PriceText}"/>
                                <GridViewColumn Header="份数" Width="50" DisplayMemberBinding="{Binding Lots}"/>
                                <GridViewColumn Header="金额" Width="80" DisplayMemberBinding="{Binding AmountText}"/>
                                <GridViewColumn Header="盈亏" Width="80" DisplayMemberBinding="{Binding PnlText}"/>
                                <GridViewColumn Header="收益率" Width="64" DisplayMemberBinding="{Binding RetText}"/>
                                <GridViewColumn Header="备注" Width="120" DisplayMemberBinding="{Binding Note}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="累计盈亏曲线（哈弗币）" Foreground="#9AA4B2"
                               FontWeight="SemiBold" Margin="2,0,0,6"/>
                    <Border Background="#0B0D10" CornerRadius="4">
                        <Canvas x:Name="EquityCanvas" ClipToBounds="True" SizeChanged="Chart_SizeChanged"/>
                    </Border>
                </DockPanel>
            </Grid>
        </Border>

        <!-- 主区域：左图表 右信号 -->
        <Grid Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#12151B" BorderBrush="#232936" BorderThickness="1" CornerRadius="6">
                <DockPanel Margin="10">
                    <Grid DockPanel.Dock="Top" Height="36">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ChartName" Text="等待行情…" Foreground="#E6E9EE" FontWeight="Bold" FontSize="15"/>
                            <Border Background="#1C212B" CornerRadius="8" Padding="7,2" Margin="12,0,0,0">
                                <TextBlock x:Name="ChartPrice" Text="--" Foreground="#FFFFFF" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="ChartChange" Text="" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="MA" Foreground="#FF8A2A" Margin="0,0,3,0"/>
                            <TextBlock x:Name="LegendMa" Text="--" Foreground="#FF8A2A" Margin="0,0,12,0"/>
                            <TextBlock Text="RSI14" Foreground="#4DA3FF" Margin="0,0,3,0"/>
                            <TextBlock x:Name="LegendRsi" Text="--" Foreground="#4DA3FF" Margin="0,0,12,0"/>
                            <TextBlock Text="区间位置" Foreground="#B98CFF" Margin="0,0,3,0"/>
                            <TextBlock x:Name="LegendPos" Text="--" Foreground="#B98CFF"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" x:Name="ChartHint" Foreground="#5A6472" FontSize="10"
                               Margin="2,0,0,4" Text="5 分钟收盘价走势（接口仅提供收盘价，故为走势面积图；橙线为均线）"/>
                    <Canvas x:Name="RsiCanvas" DockPanel.Dock="Bottom" Height="104" Margin="0,6,0,0"
                            ClipToBounds="True" SizeChanged="Chart_SizeChanged"/>
                    <Border Background="#0B0D10" CornerRadius="4">
                        <Canvas x:Name="CandleCanvas" ClipToBounds="True" SizeChanged="Chart_SizeChanged"/>
                    </Border>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="#12151B" BorderBrush="#232936" BorderThickness="1" CornerRadius="6">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="策略信号流" Foreground="#9AA4B2" FontWeight="SemiBold" Margin="2,0,0,6"/>
                    <ScrollViewer x:Name="SignalScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SignalPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
