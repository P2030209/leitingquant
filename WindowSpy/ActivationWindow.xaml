<Window x:Class="WindowSpy.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="雷霆量化系统 · 激活" Height="688" Width="487"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Border Background="{StaticResource BgWindowBrush}" CornerRadius="12"
            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Height="44" Background="{StaticResource BgHeaderBrush}">
                <Border CornerRadius="12,12,0,0" Background="{StaticResource BgHeaderBrush}" RenderTransformOrigin="0.5,0.5" Margin="0,0,15,0">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="-0.397"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="⚡" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="雷霆量化系统 · 授权激活" FontWeight="Bold" FontSize="13" Margin="8,0,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="BtnClose" Content="✕" Width="40" Height="44" HorizontalAlignment="Right"
                        Style="{x:Null}" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Click="BtnClose_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,0">
                <StackPanel Margin="24,14,24,18">

                    <!-- 开发者头像 -->
                    <Grid Width="104" Height="104" HorizontalAlignment="Center">
                        <Ellipse Width="104" Height="104" Fill="{StaticResource AccentBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FF8A2A" BlurRadius="22" ShadowDepth="0" Opacity="0.65"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="96" Height="96" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Assets/avatar.jpg" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="站长 · 超级 GGBond" HorizontalAlignment="Center" Margin="0,8,0,0"
                               Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="雷霆网络开发工作室" HorizontalAlignment="Center" Margin="0,2,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>

                    <!-- 状态原因 -->
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Padding="12,9" Margin="0,14,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●" Foreground="{StaticResource DangerBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtReason" Text="授权验证失败" Foreground="{StaticResource DangerBrush}"
                                           FontWeight="Bold" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtDetail" Text="" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" TextWrapping="Wrap" Margin="16,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 步骤 1：申请码 -->
                    <TextBlock Text="① 把本机申请码发给站长" Foreground="{StaticResource AccentBrush}"
                               FontSize="12" FontWeight="Bold" Margin="2,14,0,6"/>
                    <Border Background="{StaticResource InputBgBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtCode" Grid.Column="0" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource SuccessBrush}" FontFamily="Consolas" FontSize="12.5"
                                     IsReadOnly="True" TextWrapping="Wrap" VerticalAlignment="Center" Padding="0"/>
                            <Button x:Name="BtnCopyCode" Grid.Column="1" Content="复制" Style="{StaticResource PrimaryButton}"
                                    Padding="12,4" FontSize="11" Margin="8,0,0,0" Click="BtnCopyCode_Click"/>
                        </Grid>
                    </Border>

                    <!-- 步骤 2：联系方式 -->
                    <TextBlock Text="② 发送给站长换取 license.json（微信/邮箱均可）" Foreground="{StaticResource AccentBrush}"
                               FontSize="12" FontWeight="Bold" Margin="2,12,0,6"/>
                    <Border Background="{StaticResource InputBgBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="站长大人邮箱" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                <TextBlock Text="LeiTingQuant@126.com" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="Consolas" FontSize="14" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnCopyMail" Content="复制邮箱" Style="{StaticResource PrimaryButton}"
                                        Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="BtnCopyMail_Click"/>
                                <Button x:Name="BtnMail" Content="发邮件" Style="{StaticResource SuccessButton}"
                                        Padding="10,4" FontSize="11" Click="BtnMail_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 步骤 3：选择 license -->
                    <TextBlock Text="③ 收到 license.json 后点这里激活（也可以手动放到软件 exe 同目录后重启）"
                               Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" Margin="2,12,0,6"/>
                    <Button x:Name="BtnPick" Content="📁  选择 license.json 激活" Style="{StaticResource SuccessButton}"
                            Height="38" FontSize="13" Click="BtnPick_Click"/>

                    <TextBlock x:Name="TxtActivateResult" Text="" TextWrapping="Wrap" Margin="2,8,0,0"
                               FontSize="11.5" Foreground="{StaticResource SuccessBrush}"/>

                    <Border Background="{StaticResource AccentMutedBrush}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="⚠ license.json 一个字节都不能改：手动修改到期时间/功能会导致签名失效（提示&quot;签名无效&quot;）。续期、换机请直接找站长，授权与本机硬件绑定。"/>
                    </Border>

                    <Button x:Name="BtnExit" Content="退出软件" Style="{StaticResource DangerButton}"
                            Height="34" Margin="0,12,0,0" Click="BtnExit_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
