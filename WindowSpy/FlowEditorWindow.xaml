<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="WindowSpy.FlowEditorWindow"
        Title="流程工坊 - 可视化方案编辑器" Height="880" Width="1360"
        WindowStartupLocation="CenterScreen" Background="#0B0D10"
        FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#E6EBF2">
    <Window.Resources>
        <!-- 工坊独立风格，不继承主窗口 -->
        <Style x:Key="FBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#1A1F29"/>
            <Setter Property="Foreground" Value="#DCE3EC"/>
            <Setter Property="BorderBrush" Value="#2E3645"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF8A2A"/>
                                <Setter TargetName="Bd" Property="Background" Value="#232A36"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FBtnRun" TargetType="{x:Type Button}" BasedOn="{StaticResource FBtn}">
            <Setter Property="Foreground" Value="#58E07D"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#2E6B41"/>
        </Style>
        <Style x:Key="FBtnStop" TargetType="{x:Type Button}" BasedOn="{StaticResource FBtn}">
            <Setter Property="Foreground" Value="#FF6B72"/>
            <Setter Property="BorderBrush" Value="#6B2E33"/>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#11151C"/>
            <Setter Property="Foreground" Value="#E6EBF2"/>
            <Setter Property="CaretBrush" Value="#FF8A2A"/>
            <Setter Property="BorderBrush" Value="#2E3645"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#E6EBF2"/>
            <Setter Property="Margin" Value="2,8,2,2"/>
        </Style>
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="#0E1116"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E6EBF2"/>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#E6EBF2"/>
            <Setter Property="Background" Value="#11151C"/>
            <Setter Property="BorderBrush" Value="#2E3645"/>
        </Style>
        <!-- 深色右键菜单 -->
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="#141820"/>
            <Setter Property="BorderBrush" Value="#2E3645"/>
            <Setter Property="Foreground" Value="#DCE3EC"/>
        </Style>
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="#DCE3EC"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="{x:Type Separator}">
            <Setter Property="Margin" Value="6,3"/>
            <Setter Property="Background" Value="#2A3140"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 工具栏（自绘，全部明色文字） -->
        <Border DockPanel.Dock="Top" Background="#101319" BorderBrush="#232936" BorderThickness="0,0,0,1">
            <WrapPanel Margin="8,6">
                <TextBlock Text="⚙ 流程工坊" Foreground="#FF8A2A" FontWeight="Bold" FontSize="15"
                           VerticalAlignment="Center" Margin="4,0,14,0"/>
                <Button Content="新建" Style="{StaticResource FBtn}" Click="New_Click"/>
                <Button Content="打开方案" Style="{StaticResource FBtn}" Click="Open_Click"/>
                <Button Content="保存" Style="{StaticResource FBtn}" Click="Save_Click"/>
                <Button Content="另存为" Style="{StaticResource FBtn}" Click="SaveAs_Click"/>
                <Border Width="1" Background="#232936" Margin="6,4"/>
                <Button x:Name="RunBtn" Content="▶ 运行" Style="{StaticResource FBtnRun}" Click="Run_Click"/>
                <Button x:Name="StopBtn" Content="■ 停止" Style="{StaticResource FBtnStop}" Click="Stop_Click" IsEnabled="False"/>
                <Border Width="1" Background="#232936" Margin="6,4"/>
                <Button Content="🧹 整理布局" Style="{StaticResource FBtn}" Click="Arrange_Click"
                        ToolTip="按执行顺序从上到下自动分层排列，消除连线交叉"/>
                <Border Width="1" Height="26" Background="#232936" Margin="6,2"/>
                <TextBlock Text="流程模板→" Foreground="#7E8896" FontSize="11" VerticalAlignment="Center" Margin="2,0,4,0"/>
                <Button Content="①新手测试" Style="{StaticResource FBtn}" Click="TplMailTest_Click"
                        ToolTip="只领邮件+读余额，不买不卖，首次配坐标用"/>
                <Button Content="②盯盘播报" Style="{StaticResource FBtn}" Click="TplWatch_Click"
                        ToolTip="每60秒网络选品，达标响铃打印，不操作游戏"/>
                <Button Content="③抄底建仓" Style="{StaticResource FBtn}" Click="TplDipBuy_Click"
                        ToolTip="DIP超跌选品，达标买入1份，单次结束"/>
                <Button Content="④秒卖上架" Style="{StaticResource FBtn}" Click="TplQuickSell_Click"
                        ToolTip="选子弹→弹窗选交易行→删位法定价→确认上架，有持仓时一键卖"/>
                <Button Content="⑤军需清仓" Style="{StaticResource FBtn}" Click="TplRecycle_Click"
                        ToolTip="推车批量选取→军需处回收，白绿品垃圾变现"/>
                <Button Content="⑥标准倒卖" Style="{StaticResource FBtn}" Click="TplStandard_Click"
                        ToolTip="999轮：领币→选品→买入→盯盘→上架 教学版"/>
                <Button Content="⑦完整交易" Style="{StaticResource FBtn}" Click="TplFull_Click"
                        ToolTip="全自动闭环：双层封禁急停+领币+选品+买卖+盯盘+成交提醒"/>
                <Button Content="⑧无限托管" Style="{StaticResource FBtn}" Click="TplLoopForever_Click"
                        ToolTip="循环次数=0永不停轮：领币→选品→买卖→上架，仅F12退出"/>
                <Button Content="⑨只播报" Style="{StaticResource FBtn}" Click="TplAnnounceOnly_Click"
                        ToolTip="领币后60秒一轮网络选品，达标只响铃打印，绝不买卖"/>
                <Button Content="⑩秒卖补货" Style="{StaticResource FBtn}" Click="TplRelistLoop_Click"
                        ToolTip="无限循环：读持仓→删位法秒上架→等成交→买回1份"/>
                <Button Content="⑪领币清仓" Style="{StaticResource FBtn}" Click="TplMailRecycle_Click"
                        ToolTip="单次：领邮件哈弗币→开仓库→军需处批量回收"/>
                <Button Content="⚡ 更多模板" Style="{StaticResource FBtn}" Click="TplMore_Click"
                        ToolTip="AI决策买入/AI持仓管家/AI量化闭环/AI盯盘/六策略轮测/Lua仓位/多品种分仓/Lua选品/Python统计…全部模板都在这里"/>
                <Border Width="1" Height="26" Background="#232936" Margin="6,2"/>
                <Button Content="🖼 模板库" Style="{StaticResource FBtn}" Click="TemplateLib_Click"/>
                <Button Content="🗑 清空" Style="{StaticResource FBtn}" Click="Clear_Click"/>
                <Border Width="1" Background="#232936" Margin="6,4"/>
                <TextBlock VerticalAlignment="Center" Foreground="#6B7686" FontSize="11" TextWrapping="Wrap" MaxWidth="420"
                           Text="节点从上到下执行｜卡片顶部蓝点=入口 底部橙点=出口(编号对应分支)｜左侧青虚线=循环回流｜空白/中键拖动平移｜滚轮滚动｜Delete删除｜F12急停"/>
            </WrapPanel>
        </Border>

        <!-- 底部：日志 + 变量 -->
        <Grid DockPanel.Dock="Bottom" Height="200">
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#101319">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="运行日志" Foreground="#9AA6B5" Margin="10,5,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="变量监视" Foreground="#9AA6B5" Margin="10,5,0,0" VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="LogBox" Background="#0C0F14" BorderBrush="#232936" BorderThickness="0,1,1,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas" FontSize="12" d:ItemsSource="{d:SampleData ItemCount=5}"/>
                <ListBox x:Name="VarBox" Grid.Column="1" Background="#0C0F14" BorderBrush="#232936"
                         BorderThickness="0,1,0,0" FontFamily="Consolas" FontSize="12" d:ItemsSource="{d:SampleData ItemCount=5}"/>
            </Grid>
        </Grid>

        <!-- 主区域 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- 节点工具箱 -->
            <Border Grid.Column="0" Background="#0E1116" BorderBrush="#232936" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="节点工具箱（拖到画布）" Foreground="#9AA6B5"
                               Margin="10,8" TextWrapping="Wrap"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ToolboxPanel" Margin="6,0"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 画布 -->
            <Border Grid.Column="1" Background="#0B0D10">
                <Grid>
                    <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="CanvasScroll_PreviewMouseWheel"
                              ScrollChanged="CanvasScroll_ScrollChanged">
                        <Canvas x:Name="Canvas" Width="5000" Height="3600" AllowDrop="True"
                            DragEnter="Canvas_DragEnter" Drop="Canvas_Drop"
                            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                            MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                            MouseDown="Canvas_MouseDown"
                            MouseUp="Canvas_MouseUp"
                            MouseMove="Canvas_MouseMove">
                            <Canvas.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing>
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1"/>
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                            <GeometryDrawing.Brush>#171C24</GeometryDrawing.Brush>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Canvas.Background>
                        </Canvas>
                    </ScrollViewer>
                    <!-- 操作提示 + 缩放（悬浮不挡操作） -->
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,14,10"
                        Background="#CC0E1116" BorderBrush="#232936" BorderThickness="1" CornerRadius="5"
                        Padding="9,5">
                        <StackPanel>
                            <TextBlock x:Name="ZoomLabel" Text="100%" Foreground="#FF8A2A" FontSize="11"
                                   HorizontalAlignment="Right" Cursor="Hand" MouseLeftButtonUp="ZoomReset_Click"
                                   ToolTip="点击复位缩放"/>
                            <TextBlock Foreground="#7E8896" FontSize="10" Text="滚轮上下｜Shift+滚轮左右｜中键/空白拖动平移｜Ctrl+滚轮缩放"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 属性面板 -->
            <Border Grid.Column="2" Background="#0E1116" BorderBrush="#232936" BorderThickness="1,0,0,0">
                <DockPanel>
                    <TextBlock x:Name="PropTitle" DockPanel.Dock="Top" Text="属性（点选节点）"
                               Foreground="#FF8A2A" FontWeight="Bold" Margin="12,10,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PropPanel" Margin="10,0"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>